{
  "name": "ai-nour-phase1",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "AI Nour Phase 3 launch candidate: Cloudflare Worker, Gemini text/Live, Google integrations, CRM/email pipeline, and private admin",
  "scripts": {
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:knowledge && npm run build:ui",
    "dev": "wrangler dev --local --port 8789",
    "db:migrate:local": "wrangler d1 migrations apply ai-nour-phase1-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-nour-phase1-dev --remote",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "admin": "node scripts/admin-server.mjs",
    "admin:production": "ADMIN_ENV_FILE=.dev.vars.production ADMIN_PORT=8791 node scripts/admin-server.mjs",
    "deploy:production": "wrangler deploy --config wrangler.production.toml",
    "retrieval": "node tests/retrieval-benchmark.mjs",
    "test:security": "node scripts/security-api.mjs",
    "test:real": "node scripts/real-smoke.mjs",
    "test:fr": "node scripts/real-french.mjs",
    "test:recovery": "node scripts/recovery-test.mjs",
    "google:synthetic": "node scripts/google-synthetic.mjs",
    "build:companion-sdk": "node scripts/build-companion-sdk.mjs",
    "test:crm": "node scripts/test-crm.mjs",
    "test:crm:google": "node scripts/test-crm-google.mjs",
    "test:crm:sheet-live": "node scripts/test-crm-sheet-live.mjs",
    "test:crm:sheet-sync": "node scripts/test-crm-sheet-sync-live.mjs",
    "apply:crm-schema": "node scripts/apply-crm-schema.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:admin-auth": "node scripts/test-admin-auth.mjs",
    "test:live-budget": "node scripts/test-live-budget.mjs"
  },
  "dependencies": {
    "@google/genai": "3.6.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.168.0"
  }
}
